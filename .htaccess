RewriteEngine On
RewriteBase /hh/

# Keep requests for static assets and project internals untouched
RewriteRule ^(assets|config|controller|model|view|\.git)(/.*|$) - [L,NC]
RewriteRule ^(assets|config|controller|model|view|\.git)(/.*|$) - [L,NC]
RewriteRule \.(css|js|png|jpg|jpeg|gif|svg|ico|webp|mp4|json|woff|woff2|ttf|eot)$ - [L,NC]

# Route requests for missing files and directories through the PHP router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
