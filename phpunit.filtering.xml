<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/Filtering/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.filtering.cache">
    <testsuites>
        <testsuite name="Filtering">
            <directory suffix="Test.php">tests/Filtering/PHP</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <file>app/controllers/BooksController.php</file>
            <file>app/models/BookModel.php</file>
        </include>
    </source>

    <coverage includeUncoveredFiles="true"/>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
    </php>
</phpunit>
